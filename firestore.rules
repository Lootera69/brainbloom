rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Puzzles: public content, readable by all. Studio writes are
    // invite-code gated client-side (existing app design).
    match /puzzles/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Settings: studio config, pricing, weekly cipher — readable by all,
    // writes gated client-side by studio invite codes.
    match /settings/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Users: owner-only. Protects profiles and push tokens from
    // other users reading/writing them.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /pushTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
