rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid))
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/staffAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.get('status', 'active') == 'active'
        && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.role in ['admin', 'contributor', 'reviewer'];
    }

    function isAdmin() {
      return isStaff()
        && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnDraft(data) {
      return isStaff()
        && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.role == 'contributor'
        && data.createdBy == request.auth.uid && data.published == false;
    }

    function isReviewUpdate() {
      return isStaff()
        && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.role == 'reviewer'
        && resource.data.published == false
        && resource.data.reviewStatus in ['pending', 'needs-discussion']
        && request.resource.data.reviewStatus in ['approved', 'rejected', 'needs-discussion']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reviewStatus', 'reviewedBy', 'reviewNote', 'reviewComments', 'lastModifiedBy', 'updatedAt'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.lastModifiedBy == request.auth.uid
        && (request.resource.data.updatedAt is timestamp || request.resource.data.updatedAt is number)
        && (request.resource.data.get('reviewNote', null) == null
          || (request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 2000))
        && validCommentUpdate();
    }

    function validCommentUpdate() {
      let old = resource.data.get('reviewComments', null) == null ? [] : resource.data.reviewComments;
      let next = request.resource.data.get('reviewComments', null) == null ? [] : request.resource.data.reviewComments;
      return next == old || (next is list && next.size() == old.size() + 1
        && next.removeAll([next[next.size() - 1]]) == old
        && next[next.size() - 1].keys().hasOnly(['text', 'author', 'timestamp'])
        && next[next.size() - 1].author == request.auth.uid
        && next[next.size() - 1].text is string
        && next[next.size() - 1].text.size() > 0
        && next[next.size() - 1].text.size() <= 5000
        && next[next.size() - 1].timestamp is number);
    }

    match /puzzles/{id} {
      allow read: if isStaff();
      allow create: if isAdmin() || (isOwnDraft(request.resource.data)
        && request.resource.data.reviewStatus in ['draft', 'pending']
        && request.resource.data.get('reviewedBy', null) == null
        && request.resource.data.get('reviewNote', null) == null
        && request.resource.data.get('reviewComments', null) in [null, []]
        && request.resource.data.get('completedBy', 0) == 0);
      allow update: if isAdmin() || isReviewUpdate() || (isOwnDraft(resource.data)
        && isOwnDraft(request.resource.data)
        && (request.resource.data.reviewStatus == 'draft'
          || (request.resource.data.reviewStatus == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reviewStatus', 'reviewedBy', 'reviewComments', 'lastModifiedBy', 'updatedAt']))
          || (request.resource.data.reviewStatus == resource.data.reviewStatus
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reviewComments', 'lastModifiedBy', 'updatedAt'])))
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['createdBy', 'createdAt', 'completedBy', 'reviewNote'])
        && (request.resource.data.get('reviewedBy', null) == resource.data.get('reviewedBy', null)
          || request.resource.data.get('reviewedBy', null) == null)
        && validCommentUpdate());
      allow delete: if isAdmin() || isOwnDraft(resource.data);
    }

    match /settings/{id} {
      allow read: if id in ['pricing', 'lesson-groups', 'daily-puzzle', 'weekly-cipher', 'cipher-history']
        || (id == 'events' && isAdmin());
      allow write: if (isAdmin() && id in ['pricing', 'lesson-groups', 'daily-puzzle', 'weekly-cipher', 'cipher-history', 'events'])
        || (isStaff() && id == 'lesson-groups'
          && get(/databases/$(database)/documents/staffAccess/$(request.auth.uid)).data.role == 'contributor');
    }

    match /staffAccess/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /staffInvites/{id} {
      allow read, write: if false;
    }

    match /accountDeletions/{uid} {
      allow read, write: if false;
    }

    match /playerProgress/{uid}/{document=**} {
      allow read, write: if false;
    }

    match /playerMigrations/{document=**} {
      allow read, write: if false;
    }

    function profileFields() {
      return ['displayName', 'email', 'photoURL', 'avatarId', 'soundEnabled', 'hapticsEnabled', 'theme', 'timeZone', 'profileUpdatedAt'];
    }

    function optionalText(data, key, max) {
      return data.get(key, null) == null || (data[key] is string && data[key].size() <= max);
    }

    function validProfile(data) {
      return optionalText(data, 'displayName', 100)
        && optionalText(data, 'email', 320)
        && optionalText(data, 'photoURL', 2000)
        && optionalText(data, 'avatarId', 100)
        && optionalText(data, 'timeZone', 100)
        && data.get('theme', 'system') in ['light', 'dark', 'system']
        && data.get('soundEnabled', true) is bool
        && data.get('hapticsEnabled', true) is bool
        && data.get('profileUpdatedAt', 0) is number;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/accountDeletions/$(uid))
        && request.resource.data.keys().hasOnly(profileFields())
        && validProfile(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/accountDeletions/$(uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields())
        && validProfile(request.resource.data);
      allow delete: if false;

      match /pushTokens/{tokenId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/accountDeletions/$(uid));
      }
    }
  }
}
